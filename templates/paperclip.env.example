# Copy to /home/paperclip/paperclip.env and chmod 600 paperclip:paperclip
# Do not commit the real file.
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_AUTH_PUBLIC_BASE_URL=https://__DOMAIN_AI__
PAPERCLIP_ALLOWED_HOSTNAMES=__DOMAIN_AI__
# Optional. Set after login; do not put API keys here if they also live in Paperclip secrets.
# GEMINI_API_KEY=
