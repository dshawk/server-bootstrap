# Copy to /root/server-bootstrap.env or ./env on the target server.
# chmod 600. Do not commit the real file.

# Required for certificates and domain vhosts
ACME_EMAIL=you@example.com
DOMAIN_AI=ai.example.com
DOMAIN_MONITORING=monitoring.example.com

# Optional; auto-detected from the default route / ifconfig
# SERVER_IP=203.0.113.10

# Client emails used in the xray template: <prefix>-<suffix>
# Default matches the current production policy (Google domains via WARP,
# UDP/443 blocked) for these prefixes.
# WARP_CLIENT_PREFIXES=home,job,dshawk
# WARP_CLIENT_SUFFIXES=xhttp,tcp,vk,reality,maska

# Comma-separated 3x-ui subscription path names that get Happ/Incy
# whitelist routing headers (leave empty to skip the special nginx location).
# SUB_PATHS=job,home,dshawk

# Extra addresses fail2ban should never ban (space-separated).
# ADMIN_IPS=203.0.113.20

# Optional pinned versions (defaults match the current production server)
# XUI_VERSION=2.8.10
# XRAY_VERSION=26.6.27
# PAPERCLIP_VERSION=2026.1023.0
# GEMINI_CLI_VERSION=0.67.0
# CURSOR_AGENT_VERSION=2026.11.05-86047df

# Optional Kimi Code region file (the current production host uses mainland-cn;
# leave empty on a new server unless you know you need it).
# KIMI_REGION=

# SKIP_CERT=1
